# Supabase project settings — get these from your Supabase project dashboard
# Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is used ONLY in trusted server-side scripts (e.g. scripts/seed.mjs)
# NEVER expose this in client code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
